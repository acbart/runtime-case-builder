{
  "name": "runtime-case-builder",
  "version": "1.0.0",
  "description": "Build up your case for the runtime of an algorithm",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "build": "webpack --mode=development",
    "watch": "webpack serve --open",
    "test:js": "jest tests/utilities.test.js tests/models.test.js tests/execution.test.js",
    "test:py": "python3 -m pytest tests/test_step_counter.py -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acbart/runtime-case-builder.git"
  },
  "author": "acbart",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/acbart/runtime-case-builder/issues"
  },
  "homepage": "https://github.com/acbart/runtime-case-builder#readme",
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/plugin-proposal-class-properties": "^7.12.13",
    "@babel/preset-env": "^7.12.16",
    "@jest/globals": "^30.5.0",
    "babel-jest": "^30.5.0",
    "babel-loader": "^8.2.2",
    "clean-webpack-plugin": "^3.0.0",
    "copy-webpack-plugin": "^7.0.0",
    "css-loader": "^5.0.2",
    "file-loader": "^6.2.0",
    "html-webpack-plugin": "^5.1.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "sass": "^1.32.7",
    "sass-loader": "^11.0.1",
    "style-loader": "^2.0.0",
    "webpack": "^5.21.2",
    "webpack-cli": "^4.5.0",
    "webpack-dev-server": "^3.11.2"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.2",
    "bootstrap": "^4.6.0",
    "bootswatch": "^4.6.0",
    "chart.js": "^2.9.4",
    "codemirror": "^5.59.2",
    "jquery": "^3.5.1",
    "jquery-ui": "^1.12.1",
    "knockout": "^3.5.1",
    "popper.js": "^1.16.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testMatch": [
      "**/tests/*.test.js"
    ],
    "moduleNameMapper": {
      "\\.s?css$": "<rootDir>/tests/__mocks__/styleMock.js",
      "\\.(ico|jpg|png|svg|woff|woff2|ttf|eot)$": "<rootDir>/tests/__mocks__/fileMock.js"
    }
  }
}
