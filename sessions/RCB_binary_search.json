  "code": "def binary_search(values: list, key: int) -> int:\n    low = 0\n    high = len(values) - 1\n    while low <= high:\n        mid = (low + high) // 2\n        if values[mid] == key:\n            return mid\n        elif values[mid] < key:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return -1\n\nprint(binary_search(numbers, target))",
